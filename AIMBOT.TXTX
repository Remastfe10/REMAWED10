-- Servizi necessari
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local StarterGui = game:GetService("StarterGui")

local localPlayer = Players.LocalPlayer
local playerGui = localPlayer:WaitForChild("PlayerGui")
local camera = Workspace.CurrentCamera

-- ==========================================
-- FUNZIONE 1: CODICE PER MOBILE
-- ==========================================
local function startMobileAimbot()
	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "Remawed10AimbotGui"
	screenGui.ResetOnSpawn = false
	screenGui.Parent = playerGui

	local mainFrame = Instance.new("Frame")
	mainFrame.Size = UDim2.new(0, 260, 0, 180)
	mainFrame.Position = UDim2.new(0.5, -130, 0.3, 0)
	mainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
	mainFrame.BorderSizePixel = 0
	mainFrame.Active = true
	mainFrame.Parent = screenGui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = mainFrame

	local dragBar = Instance.new("TextButton")
	dragBar.Size = UDim2.new(1, 0, 0, 35)
	dragBar.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
	dragBar.Text = "  Remawed10 aimbot mobile (BETA)"
	dragBar.TextColor3 = Color3.fromRGB(255, 255, 255)
	dragBar.TextSize = 14
	dragBar.Font = Enum.Font.GothamBold
	dragBar.TextXAlignment = Enum.TextXAlignment.Left
	dragBar.AutoButtonColor = false
	dragBar.Parent = mainFrame

	local dragCorner = Instance.new("UICorner")
	dragCorner.CornerRadius = UDim.new(0, 10)
	dragCorner.Parent = dragBar

	local welcomeLabel = Instance.new("TextLabel")
	welcomeLabel.Size = UDim2.new(1, -20, 0, 40)
	welcomeLabel.Position = UDim2.new(0, 10, 0, 45)
	welcomeLabel.BackgroundTransparency = 1
	welcomeLabel.Text = "welcome to aimbot mobile!. ⚠️BETA⚠️ "
	welcomeLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
	welcomeLabel.TextSize = 14
	welcomeLabel.Font = Enum.Font.Gotham
	welcomeLabel.TextWrapped = true
	welcomeLabel.Parent = mainFrame

	local toggleButton = Instance.new("TextButton")
	toggleButton.Size = UDim2.new(1, -30, 0, 55)
	toggleButton.Position = UDim2.new(0, 15, 0, 105)
	toggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
	toggleButton.Text = "Aimbot: OFF"
	toggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
	toggleButton.TextSize = 16
	toggleButton.Font = Enum.Font.GothamBold
	toggleButton.Parent = mainFrame

	local btnCorner = Instance.new("UICorner")
	btnCorner.CornerRadius = UDim.new(0, 8)
	btnCorner.Parent = toggleButton

	-- Sistema di trascinamento fluido
	local dragging = false
	local mousePos, framePos

	dragBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			mousePos = input.Position
			framePos = mainFrame.Position

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - mousePos
			mainFrame.Position = UDim2.new(
				framePos.X.Scale,
				framePos.X.Offset + delta.X,
				framePos.Y.Scale,
				framePos.Y.Offset + delta.Y
			)
		end
	end)

	-- Stato dell'aimbot
	local aimbotActive = false

	toggleButton.MouseButton1Click:Connect(function()
		aimbotActive = not aimbotActive
		if aimbotActive then
			toggleButton.Text = "Aimbot: ON"
			toggleButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
		else
			toggleButton.Text = "Aimbot: OFF"
			toggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
		end
	end)

	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude

	local function getClosestVisibleTarget()
		local character = localPlayer.Character
		if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end

		local myRootPart = character.HumanoidRootPart
		local closestTarget = nil
		local shortestDistance = math.huge

		raycastParams.FilterDescendantsInstances = {character}
		local origin = camera.CFrame.Position

		for _, descendant in ipairs(Workspace:GetDescendants()) do
			if descendant:IsA("Humanoid") and descendant.Health > 0 then
				local model = descendant.Parent
				if model and model:IsA("Model") and model ~= character then
					local rootPart = model:FindFirstChild("HumanoidRootPart")
						or model:FindFirstChild("Torso")
						or model:FindFirstChild("UpperTorso")
						or model:FindFirstChild("Head")

					if rootPart then
						local distance = (myRootPart.Position - rootPart.Position).Magnitude

						if distance < shortestDistance then
							local direction = (rootPart.Position - origin)
							local raycastResult = Workspace:Raycast(origin, direction, raycastParams)

							if raycastResult and raycastResult.Instance:IsDescendantOf(model) then
								shortestDistance = distance
								closestTarget = rootPart
							end
						end
					end
				end
			end
		end

		return closestTarget
	end

	RunService.RenderStepped:Connect(function(dt)
		if not aimbotActive then return end

		local targetPart = getClosestVisibleTarget()
		local character = localPlayer.Character

		if targetPart and character and character:FindFirstChild("HumanoidRootPart") then
			local myRootPart = character.HumanoidRootPart
			local targetPosition = targetPart.Position + Vector3.new(0, 0.2, 0)

			local currentCF = camera.CFrame
			local targetCF = CFrame.new(currentCF.Position, targetPosition)
			camera.CFrame = currentCF:Lerp(targetCF, math.clamp(dt * 35, 0, 1))

			local lookAtVector = Vector3.new(targetPosition.X, myRootPart.Position.Y, targetPosition.Z)
			myRootPart.CFrame = myRootPart.CFrame:Lerp(CFrame.new(myRootPart.Position, lookAtVector), math.clamp(dt * 35, 0, 1))
		end
	end)
end

-- ==========================================
-- FUNZIONE 2: CODICE PER PC
-- ==========================================
local function startPCAimbot()
	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "Remawed10AimbotHUD"
	screenGui.ResetOnSpawn = false
	screenGui.Parent = playerGui

	local hintBackground = Instance.new("Frame")
	hintBackground.Size = UDim2.new(0, 280, 0, 40)
	hintBackground.Position = UDim2.new(0.5, -140, 1, -70)
	hintBackground.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
	hintBackground.BackgroundTransparency = 0.4
	hintBackground.BorderSizePixel = 0
	hintBackground.Parent = screenGui

	local bgCorner = Instance.new("UICorner")
	bgCorner.CornerRadius = UDim.new(0, 8)
	bgCorner.Parent = hintBackground

	local hintLabel = Instance.new("TextLabel")
	hintLabel.Size = UDim2.new(1, 0, 1, 0)
	hintLabel.BackgroundTransparency = 1
	hintLabel.Text = "Press [P] to activate aimbot"
	hintLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
	hintLabel.TextSize = 14
	hintLabel.Font = Enum.Font.GothamBold
	hintLabel.Parent = hintBackground

	local aimbotActive = false

	local function sendNotification(title, text)
		StarterGui:SetCore("SendNotification", {
			Title = title;
			Text = text;
			Icon = "rbxthumb://type=Asset&id=5107182114&w=150&h=150",
			Duration = 3
		})
	end

	local function toggleAimbot()
		aimbotActive = not aimbotActive
		if aimbotActive then
			hintLabel.Text = "Press [B] to deactivate"
			sendNotification("Remawed10 Aimbot", "AIMBOT ACTIVATE ⚠️BETA⚠️")
		else
			hintLabel.Text = "Press [P] to activate aimbot"
			sendNotification("Remawed10 Aimbot", "AIMBOT OFF")
		end
	end

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		if input.KeyCode == Enum.KeyCode.P then
			toggleAimbot()
		elseif input.KeyCode == Enum.KeyCode.B and aimbotActive then
			toggleAimbot()
		end
	end)

	task.spawn(function()
		while true do
			if not aimbotActive then
				for i = 220, 100, -10 do
					if aimbotActive then break end
					hintLabel.TextColor3 = Color3.fromRGB(i, i, i)
					task.wait(0.04)
				end
				for i = 100, 220, 10 do
					if aimbotActive then break end
					hintLabel.TextColor3 = Color3.fromRGB(i, i, i)
					task.wait(0.04)
				end
			else
				hintLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
				task.wait(1)
			end
			task.wait(0.05)
		end
	end)

	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude

	local function getClosestVisibleTarget()
		local character = localPlayer.Character
		if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end

		local myRootPart = character.HumanoidRootPart
		local closestTarget = nil
		local shortestDistance = math.huge

		raycastParams.FilterDescendantsInstances = {character}
		local origin = camera.CFrame.Position

		for _, descendant in ipairs(Workspace:GetDescendants()) do
			if descendant:IsA("Humanoid") and descendant.Health > 0 then
				local model = descendant.Parent
				if model and model:IsA("Model") and model ~= character then
					local rootPart = model:FindFirstChild("HumanoidRootPart")
						or model:FindFirstChild("Torso")
						or model:FindFirstChild("UpperTorso")
						or model:FindFirstChild("Head")

					if rootPart then
						local distance = (myRootPart.Position - rootPart.Position).Magnitude

						if distance < shortestDistance then
							local direction = (rootPart.Position - origin)
							local raycastResult = Workspace:Raycast(origin, direction, raycastParams)

							if raycastResult and raycastResult.Instance:IsDescendantOf(model) then
								shortestDistance = distance
								closestTarget = rootPart
							end
						end
					end
				end
			end
		end

		return closestTarget
	end

	RunService.RenderStepped:Connect(function(dt)
		if not aimbotActive then return end

		local targetPart = getClosestVisibleTarget()
		local character = localPlayer.Character

		if targetPart and character and character:FindFirstChild("HumanoidRootPart") then
			local myRootPart = character.HumanoidRootPart
			local targetPosition = targetPart.Position + Vector3.new(0, 0.2, 0)

			local currentCF = camera.CFrame
			local targetCF = CFrame.new(currentCF.Position, targetPosition)
			camera.CFrame = currentCF:Lerp(targetCF, math.clamp(dt * 35, 0, 1))

			local lookAtVector = Vector3.new(targetPosition.X, myRootPart.Position.Y, targetPosition.Z)
			myRootPart.CFrame = myRootPart.CFrame:Lerp(CFrame.new(myRootPart.Position, lookAtVector), math.clamp(dt * 35, 0, 1))
		end
	end)
end

