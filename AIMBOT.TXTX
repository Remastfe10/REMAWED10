statusLabel.Text = ""
statusLabel.Parent = contentFrame

-- Variabili di controllo per evitare avvii multipli
local selected = false
local spaceConnection

local function handleSelection(platform)
	if selected then return end
	selected = true

	-- Disconnette l'ascolto della barra spaziatrice per evitare conflitti successivi
	if spaceConnection then
		spaceConnection:Disconnect()
	end

	phoneButton.Active = false
	pcButton.Active = false

	if platform == "Mobile" then
		statusLabel.Text = "You play on mobile"
	else
		statusLabel.Text = "You play on PC"
	end

	task.delay(1.2, function()
		if welcomeGui and welcomeGui.Parent then
			local info = TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			local t1 = TweenService:Create(mainFrame, info, {BackgroundTransparency = 1})
			local t2 = TweenService:Create(contentFrame, info, {Size = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1})

			t1:Play()
			t2:Play()

			t1.Completed:Connect(function()
				welcomeGui:Destroy()
				
				-- Avvia lo script corrispondente alla scelta
				if platform == "Mobile" then
					startMobileAimbot()
				else
					startPCAimbot()
				end
			end)
		end
	end)
end

-- Eventi di selezione
phoneButton.MouseButton1Click:Connect(function()
	handleSelection("Mobile")
end)

pcButton.MouseButton1Click:Connect(function()
	handleSelection("PC")
end)

spaceConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if input.KeyCode == Enum.KeyCode.Space then
		handleSelection("PC")
	end
end)
